{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/remind.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\remind.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/remind.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\remind.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
